# Supabase (Phase 1)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (used by Supabase Edge Functions, not bundled into the client)
SUPABASE_SERVICE_ROLE_KEY=

# AI providers (stored encrypted in `integrations` table at runtime; these are
# only used as fallbacks / dev defaults inside Edge Functions)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Resend (email notifications)
RESEND_API_KEY=

# Wrike OAuth
WRIKE_CLIENT_ID=
WRIKE_CLIENT_SECRET=
WRIKE_REDIRECT_URI=blitzy://wrike-callback
