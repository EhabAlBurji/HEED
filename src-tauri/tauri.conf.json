{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Heed",
  "version": "0.1.1",
  "identifier": "app.heed",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Heed",
        "width": 1200,
        "height": 800,
        "minWidth": 260,
        "minHeight": 80,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true,
        "transparent": false,
        "fullscreen": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Focus on what matters",
    "longDescription": "Heed turns thoughts into plans. Task management, focus timer, Pomodoro, productivity reports, and AI brain dump.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "heed"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/EhabAlBurji/Mindora/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyNDhFQjIxQzVDNjNDQjEKUldTeFBNYkZJZXRJb3VtYlpmbktOM0Z4bzR3THdPTXNsYzBJaUhBZTk3N1hBaEl5UHJxTVBVSUEK"
    }
  }
}
