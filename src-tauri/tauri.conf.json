{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Heed",
  "version": "0.1.41",
  "identifier": "app.heed",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Heed",
        "width": 1200,
        "height": 800,
        "minWidth": 260,
        "minHeight": 80,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true,
        "transparent": false,
        "fullscreen": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.groq.com https://api.anthropic.com https://image.pollinations.ai https://api.cloudflare.com https://huggingface.co https://router.huggingface.co; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Focus on what matters",
    "longDescription": "Heed turns thoughts into plans. Task management, focus timer, Pomodoro, productivity reports, and AI brain dump.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "heed"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/EhabAlBurji/Heed/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVERDc1NzcyMDlEQUVBMzIKUldReTZ0b0pjbGZYN2Z2c2dSRG4rYnY4bFZpb1JkVGZYOGFHSEN0d2UyaGFKWVZ4cHM5aGtxaFgK"
    }
  }
}
